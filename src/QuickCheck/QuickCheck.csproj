<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>QuickCheck</PackageId>
        <Description>Property-based testing for .NET: describe a property over generated inputs, and QuickCheck searches for a counterexample and shrinks it to a minimal failing case.</Description>
        <PackageTags>QuickCheck, Fuzz, Fuzzer, Testing</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="QuickCheck.Tests" />
    </ItemGroup>

</Project>
