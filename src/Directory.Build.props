<Project>
  <!-- MSBuild stops at the first Directory.Build.props it finds walking up, so
       the repository-wide settings have to be pulled in explicitly. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove($(MSBuildThisFile), $(MSBuildThisFileDirectory)..))" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <EnablePackageValidation>true</EnablePackageValidation>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <Authors>Ryan Buckley</Authors>
    <Copyright>Copyright © Ryan Buckley</Copyright>
    <PackageProjectUrl>https://github.com/rabuckley/quickcheck-dotnet</PackageProjectUrl>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <!--
    MinVer sets AssemblyVersion to $(MinVerMajor).0.0.0, which is right from 1.0.0 on. Below 1.0.0
    the minor is that boundary.
  -->
  <Target Name="SetPreReleaseAssemblyVersion" AfterTargets="MinVer" Condition="'$(MinVerMajor)' == '0'">
    <PropertyGroup>
      <AssemblyVersion>0.$(MinVerMinor).0.0</AssemblyVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../readme.md" Pack="true" PackagePath="\" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>
</Project>
